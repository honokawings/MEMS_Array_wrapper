# Post-SYN exact RAW Gray constraints; normal meta->sync timing stays active.
set_max_skew 7.000 -from [get_pins -hierarchical -regexp {.*raw_transport.*samples.*wgray\[[0-9]+\]/Q}] -to [get_pins -hierarchical -regexp {.*raw_transport.*samples.*wgray_meta\[[0-9]+\]/D}]
set_max_delay 7.500 -datapath_only -from [get_pins -hierarchical -regexp {.*raw_transport.*samples.*wgray\[0\]/Q}] -to [get_pins -hierarchical -regexp {.*raw_transport.*samples.*wgray_meta\[0\]/D}]
